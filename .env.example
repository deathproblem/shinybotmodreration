# Токен вашего бота от @BotFather (обязательно)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ID супер-администраторов бота (через запятую, например: 123456789,987654321)
# Узнать свой ID можно в боте @userinfobot
ADMIN_IDS=[]

# Включение/отключение фильтров (True / False)
ENABLE_LINK_FILTER=True
ENABLE_PROFANITY_FILTER=True
ENABLE_SPAM_FILTER=True
ENABLE_FLOOD_FILTER=True

# Разрешить администраторам чата публиковать ссылки и обходить фильтры
ALLOW_ADMINS_BYPASS=True

# Настройки варнов и наказаний
MAX_WARNINGS=3
MUTE_DURATION_HOURS=24
AUTO_DELETE_ALERT_SECONDS=8

# Настройки антифлуда (не более 4 сообщений за 4 секунды)
FLOOD_MESSAGE_LIMIT=4
FLOOD_TIME_SECONDS=4

# Настройки антиспама
MAX_CAPS_PERCENT=70.0
MIN_CAPS_LEN=12
MAX_MENTIONS=4
BLOCK_FORWARD_FROM_CHANNELS=True

# Путь к файлу базы данных SQLite
DATABASE_PATH=moderator_bot.db
